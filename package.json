{
  "name": "minimal-react-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal React + TypeScript project bootstrapped with Vite and Yarn.",
  "main": "src/main.tsx",
  "homepage": "https://github.com/kha1ne/minimal-react-project",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kha1ne/minimal-react-project.git"
  },
  "bugs": {
    "url": "https://github.com/kha1ne/minimal-react-project/issues"
  },
  "author": "Marko Maric <mmaric@gmail.com>",
  "license": "MIT",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "yarn",
    "minimal",
    "frontend",
    "boilerplate",
    "starter"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "lit": "^3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "resolutions": {
    "baseline-browser-mapping": "^2.10.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
